# Скопируйте в .env: cp .env.example .env
# Настоящие ключи в репозиторий НЕ коммитим.

ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://kk:kk@db:5432/kk
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=kk-minio
MINIO_SECRET_KEY=kk-minio-secret
MINIO_BUCKET_RESUMES=resumes

# fake — заглушка без интернета; gigachat — настоящий провайдер (ключ ниже)
LLM_PROVIDER=fake
LLM_TIMEOUT_SECONDS=10
GIGACHAT_API_KEY=
YANDEXGPT_API_KEY=

APPLICATION_REMINDER_DAYS=5
APPLICATION_DEADLINE_DAYS=7
